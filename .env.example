# Railway injects DATABASE_URL automatically when a PostgreSQL service is linked.
DATABASE_URL=postgresql://usuario:password@host:5432/database

# Private key for access to https://your-domain/operator
# Use a long random value and never commit it to the repository.
OPERATOR_KEY=cambia-esto-por-una-clave-larga-y-segura

# Initial customer credentials and session signature.
BANK_CUSTOMER_USER=customer.portal
BANK_CUSTOMER_PASSWORD=change-this-password
BANK_SESSION_SECRET=use-another-long-random-secret
BANK_OPENING_BALANCE=12840.50

# Railway PostgreSQL requires TLS. Use false only for a local database without SSL.
DATABASE_SSL=true

# Optional (Railway assigns PORT automatically).
HOST=0.0.0.0
PORT=3000
